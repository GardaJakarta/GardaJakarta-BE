datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  WARGA
  POLISI
  ADMIN
}

enum ReportSeverity {
  P0
  P1
  P2
  P3
}

enum ReportStatus {
  PENDING
  VERIFIED
  IN_PROGRESS
  CLARIFICATION
  RESOLVED
  REJECTED
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  passwordHash  String?
  role          UserRole  @default(WARGA)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  reports       IncidentReport[]
  reportActivities ReportActivity[]
  reportVotes    ReportVote[]
  reportComments ReportComment[]
  reportEvidence ReportEvidence[]
  policeUnitId  String?
  policeUnit    PoliceUnit? @relation(fields: [policeUnitId], references: [id], onDelete: SetNull)
}

model PoliceUnit {
  id            String           @id
  name          String
  district      String
  address       String
  phone         String?
  latitude      Decimal          @db.Decimal(9, 6)
  longitude     Decimal          @db.Decimal(9, 6)
  photoUrl      String?
  isPublished   Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  reports       IncidentReport[]
  staff         User[]

  @@index([district])
  @@index([isPublished])
}

model ReportCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncidentReport {
  id            String         @id @default(cuid())
  ticketNumber  String         @unique
  category      String
  description   String
  severity      ReportSeverity  @default(P2)
  status        ReportStatus    @default(PENDING)
  latitude      Decimal        @db.Decimal(9, 6)
  longitude     Decimal        @db.Decimal(9, 6)
  reporterId    String
  reporter      User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  policeUnitId  String?
  policeUnit    PoliceUnit?    @relation(fields: [policeUnitId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activities    ReportActivity[]
  votes         ReportVote[]
  comments      ReportComment[]
  evidence      ReportEvidence[]
  clarificationPrompt       String?
  clarificationResponse     String?
  clarificationRequestedAt  DateTime?
  clarificationRespondedAt  DateTime?

  @@index([reporterId, createdAt])
  @@index([policeUnitId, status])
  @@index([status, createdAt])
}

model ReportActivity {
  id        String         @id @default(cuid())
  reportId  String
  report    IncidentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole UserRole?
  type      String
  status    ReportStatus?
  message   String
  evidence  ReportEvidence[]
  createdAt DateTime       @default(now())

  @@index([reportId, createdAt])
  @@index([actorId])
}

model ReportEvidence {
  id         String @id @default(cuid())
  reportId   String
  uploaderId String
  activityId String?
  commentId  String?
  key        String @unique
  report     IncidentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader   User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  activity   ReportActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  comment    ReportComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@index([reportId])
  @@index([uploaderId])
  @@index([activityId])
  @@index([commentId])
}

model ReportVote {
  id        String         @id @default(cuid())
  reportId  String
  voterId   String
  report    IncidentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  voter     User           @relation(fields: [voterId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([reportId, voterId])
  @@index([reportId])
  @@index([voterId])
}

model ReportComment {
  id        String         @id @default(cuid())
  reportId  String
  authorId  String
  body      String
  report    IncidentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  evidence  ReportEvidence[]
  createdAt DateTime       @default(now())

  @@index([reportId, createdAt])
  @@index([authorId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  operation  String
  resourceId String
  reason     String
  createdAt  DateTime @default(now())

  @@index([resourceId, createdAt])
}
