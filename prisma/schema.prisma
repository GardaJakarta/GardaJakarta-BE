datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  WARGA
  POLISI
  ADMIN
}

enum ReportSeverity {
  P0
  P1
  P2
  P3
}

enum ReportStatus {
  PENDING
  VERIFIED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  passwordHash  String?
  role          UserRole  @default(WARGA)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  reports       IncidentReport[]
  policeUnitId  String?
  policeUnit    PoliceUnit? @relation(fields: [policeUnitId], references: [id], onDelete: SetNull)
}

model PoliceUnit {
  id            String           @id
  name          String
  district      String
  address       String
  phone         String?
  latitude      Decimal          @db.Decimal(9, 6)
  longitude     Decimal          @db.Decimal(9, 6)
  photoUrl      String?
  isPublished   Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  reports       IncidentReport[]
  staff         User[]

  @@index([district])
  @@index([isPublished])
}

model IncidentReport {
  id            String         @id @default(cuid())
  ticketNumber  String         @unique
  category      String
  description   String
  severity      ReportSeverity  @default(P2)
  status        ReportStatus    @default(PENDING)
  latitude      Decimal        @db.Decimal(9, 6)
  longitude     Decimal        @db.Decimal(9, 6)
  reporterId    String
  reporter      User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  policeUnitId  String?
  policeUnit    PoliceUnit?    @relation(fields: [policeUnitId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([reporterId, createdAt])
  @@index([policeUnitId, status])
  @@index([status, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  operation  String
  resourceId String
  reason     String
  createdAt  DateTime @default(now())

  @@index([resourceId, createdAt])
}
