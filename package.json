{
  "name": "gardajakarta-be",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "node scripts/prisma.mjs generate && tsc -p tsconfig.json",
    "start": "npm run prisma:migrate:deploy && node dist/server.js",
    "typecheck": "node scripts/prisma.mjs generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:integration": "npm run build && node --test tests/auth.integration.mjs",
    "staff:create": "node scripts/create-staff.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:validate": "node scripts/prisma.mjs validate",
    "prisma:migrate:dev": "node scripts/prisma.mjs migrate dev --name init",
    "prisma:migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "prisma:studio": "node scripts/prisma.mjs studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.7.12",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
